# Copy to ".env" and edit, then run ./phone.sh up to apply.
# These override the defaults in docker-compose.yml.

# --- Android image -------------------------------------------------------
# For Play Store + fingerprint spoofing, use a GApps+Magisk image (default below).
# This is what makes `./phone.sh fingerprint` work and gives you the Play Store.
# It is community-maintained, so if it ever fails to pull, fall back to the
# official AOSP image (no Play Store) listed underneath.
#
#   fahaddz/redroid:13                  Android 13 + LiteGapps + Magisk  <-- default
#   redroid/redroid:13.0.0-latest       official, AOSP, NO Play Store, NO Magisk
#   redroid/redroid:12.0.0-latest       official Android 12
#   redroid/redroid:11.0.0-latest       official Android 11
REDROID_IMAGE=fahaddz/redroid:13

# --- Screen --------------------------------------------------------------
WIDTH=720
HEIGHT=1280
DPI=320

# --- GPU -----------------------------------------------------------------
# guest  = software rendering, works everywhere (default, safest)
# host   = use the host GPU (faster, needs a working GPU + drivers in container)
GPU_MODE=guest

# --- Web UI image --------------------------------------------------------
WS_SCRCPY_IMAGE=pierfra/ws-scrcpy:latest
