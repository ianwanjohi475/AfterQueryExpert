# Copy to ".env" and edit, then run ./phone.sh up to apply.
# These override the defaults in docker-compose.yml.

# --- Android image -------------------------------------------------------
# Default = plain Android 13 (AOSP, NO Google Play). Sideload APKs with
#   ./phone.sh apk phone1 some.apk
#
# To get the Google Play Store, switch to a community image that bundles
# GApps. Examples (community-maintained, use at your own discretion):
#   REDROID_IMAGE=fahaddz/redroid:13        # Android 13 + LiteGapps + Magisk
#   REDROID_IMAGE=redroid/redroid:11.0.0_gapps-latest
#
# Other official sizes:
#   redroid/redroid:13.0.0-latest
#   redroid/redroid:12.0.0-latest
#   redroid/redroid:11.0.0-latest
REDROID_IMAGE=redroid/redroid:13.0.0-latest

# --- Screen --------------------------------------------------------------
WIDTH=720
HEIGHT=1280
DPI=320

# --- GPU -----------------------------------------------------------------
# guest  = software rendering, works everywhere (default, safest)
# host   = use the host GPU (faster, needs a working GPU + drivers in container)
GPU_MODE=guest

# --- Web UI image --------------------------------------------------------
WS_SCRCPY_IMAGE=pierfra/ws-scrcpy:latest
