{
  "manifest_version": 3,
  "name": "Handshake Status Verifier",
  "version": "1.6.0",
  "description": "Rewrites /hai/graphql + /hs/graphql via CDP. Auto-logs form requests for diagnosis.",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.joinhandshake.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["intercept.js"],
      "matches": ["https://*.joinhandshake.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.joinhandshake.com/*"],
      "js": ["intercept.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://*.joinhandshake.com/*"],
      "js": ["loader.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Open Handshake Verifier"
  }
}
