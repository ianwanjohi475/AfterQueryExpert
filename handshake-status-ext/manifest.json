{
  "manifest_version": 3,
  "name": "Handshake Status Verifier",
  "version": "1.3.0",
  "description": "Rewrites /hai/graphql response bytes via CDP so DevTools and the page both see status = VERIFIED. Testing only.",
  "permissions": [
    "debugger",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*.joinhandshake.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["intercept.js"],
      "matches": ["https://*.joinhandshake.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.joinhandshake.com/*"],
      "js": ["intercept.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://*.joinhandshake.com/*"],
      "js": ["loader.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Handshake Status Verifier"
  }
}
