{
  "manifest_version": 3,
  "name": "Handshake Status Verifier",
  "version": "1.1.0",
  "description": "Intercepts /hai/graphql responses and rewrites status to VERIFIED — testing only.",
  "permissions": [],
  "host_permissions": [
    "https://ai.joinhandshake.com/*",
    "https://*.joinhandshake.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["intercept.js"],
      "matches": ["https://*.joinhandshake.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.joinhandshake.com/*"],
      "js": ["intercept.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://*.joinhandshake.com/*"],
      "js": ["loader.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Handshake Status Verifier"
  }
}
